<?xml version="1.0" encoding="utf-8"?>
<!--
  Merged into the app manifest by Unity (an .androidlib folder).

  libSnpeHtpV69Stub.so (SNPE's CPU-side half of the Hexagon NPU runtime) links
  libcdsprpc.so, the FastRPC client. It is a vendor PUBLIC library on this
  headset (/vendor/etc/public.libraries.txt), but since Android 12 an app may
  only load one it declares here - otherwise dlopen reports "not found".
  required=false: the app still installs and runs (GPU path) on devices
  without it.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="com.swapnil.cupnpu">
    <application>
        <uses-native-library android:name="libcdsprpc.so" android:required="false" />
    </application>
</manifest>
